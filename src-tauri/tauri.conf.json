{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keylight Commander Linux",
  "mainBinaryName": "keylight-commander-linux",
  "version": "0.2.4",
  "identifier": "io.github.keylight-commander-linux",
  "plugins": {},
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": false,
    "windows": [
      {
        "label": "main",
        "title": "Keylight Commander Linux",
        "hiddenTitle": true,
        "width": 400,
        "minWidth": 400,
        "height": 400,
        "minHeight": 300,
        "center": true,
        "skipTaskbar": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "resources": [
      "icons/*"
    ],
    "license": "MIT",
    "homepage": "https://github.com/davidchalifoux/keylight-commander",
    "shortDescription": "Elgato Key Light control from your Linux panel",
    "longDescription": "Linux-first fork of Keylight Commander with native panel light controls and a shared background device controller. Based on the MIT-licensed original by David Chalifoux.",
    "publisher": "Keylight Commander Linux contributors",
    "category": "Utility",
    "targets": [
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libglib2.0-bin"
        ]
      }
    }
  }
}
